# ==============================
# Supabase
# ==============================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key: server-only, NEVER expose to the client bundle.
# Used for admin writes and content-gating checks that must bypass RLS safely on the server.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================
# Kakao OAuth
# ==============================
# Configured primarily inside Supabase Dashboard > Authentication > Providers > Kakao
# (Client ID / Client Secret registered there, not read directly by this app).
# Redirect URL to whitelist in the Kakao Developers console:
#   https://<your-supabase-project>.supabase.co/auth/v1/callback

# ==============================
# TossPayments
# ==============================
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret, issued in Toss Payments Developer Center > Webhooks.
# Required to verify that /api/payments/webhook requests genuinely originate from Toss.
TOSS_WEBHOOK_SECRET=your-toss-webhook-secret

# ==============================
# App
# ==============================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================
# Admin access
# ==============================
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=sineadlee1210@gmail.com
